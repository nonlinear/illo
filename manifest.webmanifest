{
  "name": "Illo",
  "short_name": "Illo",
  "description": "A private, offline drawing app in a single HTML file.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#FAFAFA",
  "theme_color": "#18181B",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "illo-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
